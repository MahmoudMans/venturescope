{
  "name": "venturescope",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\" && prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "e2e:install": "playwright install chromium",
    "test:e2e": "bash scripts/e2e.sh",
    "test:e2e:headed": "E2E_HEADED=1 bash scripts/e2e.sh",
    "security:check": "eslint . --max-warnings=0 && pnpm typecheck && pnpm test",
    "docker:build": "docker build --target runner -t venturescope:local .",
    "production:config": "docker compose -f compose.production.yaml config",
    "release:check": "prisma validate && eslint . --max-warnings=0 && pnpm typecheck && pnpm test && pnpm test:e2e",
    "release:docker": "docker build --target runner -t venturescope:release .",
    "ops:smoke": "bash scripts/production-smoke.sh",
    "db:backup": "bash scripts/db-backup.sh",
    "db:backup:verify": "bash scripts/db-verify-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:ops:selftest": "bash scripts/db-ops-selftest.sh",
    "release:gate": "bash scripts/release-gate.sh",
    "deploy:production": "bash scripts/deploy-production.sh",
    "deploy:rollback": "bash scripts/rollback-production.sh",
    "deploy:selftest": "bash scripts/deployment-selftest.sh",
    "test:observability": "vitest run tests/observability",
    "ops:diagnostics": "bash scripts/diagnostics-smoke.sh",
    "test:account-security": "vitest run tests/account-security",
    "db:migrations:selftest": "bash scripts/migration-selftest.sh",
    "test:collaboration": "vitest run tests/collaboration",
    "test:versioning": "vitest run tests/versioning",
    "test:analytics": "vitest run tests/analytics",
    "test:actuals": "vitest run tests/actuals",
    "test:forecast-accuracy": "vitest run tests/forecast-accuracy",
    "test:planning-cycle": "vitest run tests/planning-cycle",
    "test:risk-center": "vitest run tests/risk-center",
    "test:capital-planning": "vitest run tests/capital-planning",
    "test:decision-center": "vitest run tests/decision-center",
    "test:board-room": "vitest run tests/board-room",
    "test:version-diff": "vitest run tests/version-diff",
    "test:scenario-comparison": "vitest run tests/scenario-comparison",
    "test:sensitivity-lab": "vitest run tests/sensitivity-lab",
    "test:scorecard": "vitest run tests/scorecard"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^26.1.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.17.0",
  "type": "module"
}
