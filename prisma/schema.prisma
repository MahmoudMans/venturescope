generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RevenueMode {
  DIRECT
  CUSTOMER_DRIVEN
}

enum ScenarioType {
  BASE
  BULL
  BEAR
  CUSTOM
}

enum FinancingType {
  EQUITY
  DEBT
  GRANT
  OTHER
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

model User {
  authVersion       Int       @default(0)
  passwordChangedAt DateTime?
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  passwordHash      String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  projects Project[]

  ownedWorkspaces             Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships        WorkspaceMember[]
  workspaceInvitationsCreated WorkspaceInvitation[] @relation("WorkspaceInvitationCreator")

  @@index([createdAt])
}

model Project {
  id String @id @default(cuid())

  userId String

  name          String
  industry      String?
  currency      String      @default("EUR")
  startMonth    DateTime    @db.Date
  horizonMonths Int         @default(36)
  revenueMode   RevenueMode @default(CUSTOMER_DRIVEN)

  baseAssumptions Json   @default("{}") @db.JsonB
  modelVersion    String @default("1.0")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  scenarios        Scenario[]
  financingEvents  FinancingEvent[]
  monthlyOverrides MonthlyOverride[]

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([workspaceId])
}

model Scenario {
  id String @id @default(cuid())

  projectId String

  name      String
  type      ScenarioType
  modifiers Json         @default("{}") @db.JsonB

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  overrides MonthlyOverride[]

  @@index([projectId])
  @@index([projectId, type])
}

model FinancingEvent {
  id String @id @default(cuid())

  projectId String

  name   String
  type   FinancingType
  month  DateTime      @db.Date
  amount Decimal       @db.Decimal(20, 2)

  apr                 Decimal?  @db.Decimal(9, 6)
  termMonths          Int?
  repaymentStartMonth DateTime? @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, month])
}

model MonthlyOverride {
  id String @id @default(cuid())

  projectId  String
  scenarioId String?

  month  DateTime @db.Date
  values Json     @db.JsonB
  note   String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  scenario Scenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([scenarioId])
  @@index([projectId, month])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  projects    Project[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

model WorkspaceInvitation {
  id              String        @id @default(cuid())
  workspaceId     String
  emailNormalized String
  role            WorkspaceRole
  tokenHash       String        @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdByUserId String
  createdAt       DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("WorkspaceInvitationCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, emailNormalized])
  @@index([expiresAt])
}
