generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RevenueMode {
  DIRECT
  CUSTOMER_DRIVEN
}

enum ScenarioType {
  BASE
  BULL
  BEAR
  CUSTOM
}

enum FinancingType {
  EQUITY
  DEBT
  GRANT
  OTHER
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

model User {
  authVersion       Int       @default(0)
  passwordChangedAt DateTime?
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  passwordHash      String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  projects Project[]

  ownedWorkspaces             Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships        WorkspaceMember[]
  workspaceInvitationsCreated WorkspaceInvitation[] @relation("WorkspaceInvitationCreator")

  projectRevisions ProjectRevision[] @relation("ProjectRevisionCreator")

  forecastBaselines ForecastBaseline[] @relation("ForecastBaselineCreator")

  decisionActionsCreated DecisionAction[] @relation("DecisionActionCreator")

  executiveReviewsCreated ExecutiveReview[] @relation("ExecutiveReviewCreator")

  @@index([createdAt])
}

model Project {
  id String @id @default(cuid())

  userId String

  name          String
  industry      String?
  currency      String      @default("EUR")
  startMonth    DateTime    @db.Date
  horizonMonths Int         @default(36)
  revenueMode   RevenueMode @default(CUSTOMER_DRIVEN)

  baseAssumptions  Json   @default("{}") @db.JsonB
  modelVersion     String @default("1.0")
  revisionSequence Int    @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  scenarios        Scenario[]
  financingEvents  FinancingEvent[]
  monthlyOverrides MonthlyOverride[]

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  revisions ProjectRevision[]

  actualPeriods ActualPeriod[]

  forecastBaselines ForecastBaseline[]

  riskPolicy ProjectRiskPolicy?

  decisionActions DecisionAction[]

  executiveReviews ExecutiveReview[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([workspaceId])
}

model Scenario {
  id String @id @default(cuid())

  projectId String

  name      String
  type      ScenarioType
  modifiers Json         @default("{}") @db.JsonB

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  overrides MonthlyOverride[]

  @@index([projectId])
  @@index([projectId, type])
}

model FinancingEvent {
  id String @id @default(cuid())

  projectId String

  name   String
  type   FinancingType
  month  DateTime      @db.Date
  amount Decimal       @db.Decimal(20, 2)

  apr                 Decimal?  @db.Decimal(9, 6)
  termMonths          Int?
  repaymentStartMonth DateTime? @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, month])
}

model MonthlyOverride {
  id String @id @default(cuid())

  projectId  String
  scenarioId String?

  month  DateTime @db.Date
  values Json     @db.JsonB
  note   String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  scenario Scenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([scenarioId])
  @@index([projectId, month])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  projects    Project[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

model WorkspaceInvitation {
  id              String        @id @default(cuid())
  workspaceId     String
  emailNormalized String
  role            WorkspaceRole
  tokenHash       String        @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdByUserId String
  createdAt       DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("WorkspaceInvitationCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, emailNormalized])
  @@index([expiresAt])
}

model ProjectRevision {
  id               String   @id @default(cuid())
  projectId        String
  version          Int
  label            String?
  reason           String?
  snapshot         Json
  sourceRevisionId String?
  createdByUserId  String?
  createdAt        DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ProjectRevisionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@index([createdByUserId])
  @@index([sourceRevisionId])
}

model ActualPeriod {
  id                String   @id @default(cuid())
  projectId         String
  period            DateTime
  revenue           Decimal? @db.Decimal(18, 2)
  cogs              Decimal? @db.Decimal(18, 2)
  operatingExpenses Decimal? @db.Decimal(18, 2)
  ebitda            Decimal? @db.Decimal(18, 2)
  netIncome         Decimal? @db.Decimal(18, 2)
  cashFlow          Decimal? @db.Decimal(18, 2)
  cashBalance       Decimal? @db.Decimal(18, 2)
  mrr               Decimal? @db.Decimal(18, 2)
  customers         Int?
  source            String   @default("CSV")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, period])
  @@index([projectId, period])
}

model ForecastBaseline {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  kind            String
  modelVersion    String
  snapshot        Json
  createdByUserId String?
  createdAt       DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ForecastBaselineCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, name])
  @@index([projectId, createdAt])
  @@index([createdByUserId])
}

model ProjectRiskPolicy {
  id                    String   @id @default(cuid())
  projectId             String   @unique
  minimumCash           Decimal? @db.Decimal(18, 2)
  minimumRunwayMonths   Int      @default(6)
  minimumEbitdaMargin   Decimal? @db.Decimal(8, 4)
  maximumMonthlyBurn    Decimal? @db.Decimal(18, 2)
  downsideRevenueShock  Decimal  @default(0.20) @db.Decimal(8, 4)
  downsideCostInflation Decimal  @default(0.10) @db.Decimal(8, 4)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DecisionAction {
  id              String    @id @default(cuid())
  projectId       String
  title           String
  details         String?
  sourceCode      String?
  priority        String    @default("MEDIUM")
  status          String    @default("OPEN")
  ownerName       String?
  dueDate         DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("DecisionActionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, status, dueDate])
  @@index([createdByUserId])
}

model ExecutiveReview {
  id              String   @id @default(cuid())
  projectId       String
  periodKey       String
  title           String
  commentary      String?
  modelVersion    String
  snapshot        Json
  createdByUserId String?
  createdAt       DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ExecutiveReviewCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, periodKey, createdAt])
  @@index([projectId, createdAt])
  @@index([createdByUserId])
}
